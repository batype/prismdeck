{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "outDir": "lib",
    "rootDir": "src",
    "types": ["react", "node"]
  },
  "include": [
    "src/core/config.ts",
    "src/core/workspace.ts",
    "src/components/*.tsx",
    "src/components/next.ts"
  ]
}
